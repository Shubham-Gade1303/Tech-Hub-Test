4:-4.Find the batch with the maximum number of students enrolled.
SELECT
    B.BatchName,
    COUNT(S.StudentID) AS TotalStudents
FROM Batches B
JOIN Students S
ON B.BatchID = S.BatchID
GROUP BY B.BatchName
ORDER BY TotalStudents DESC
LIMIT 1;
+-----------+---------------+
| BatchName | TotalStudents |
+-----------+---------------+
| Java_A    |             4 |
+-----------+---------------+

5:-.Find the instructor name, course name, and the number of students enrolled in each  
instructor's course.
SELECT
    I.Name AS InstructorName,
    C.CourseName,
    COUNT(S.StudentID) AS TotalStudents
FROM Instructors I
JOIN Course C
ON I.CourseID = C.CourseID
LEFT JOIN Students S
ON C.CourseID = S.CourseID
GROUP BY I.Name, C.CourseName;
