9:-.Retrieve the courses with at least 5 students enrolled.
SELECT
    C.CourseName,
    COUNT(S.StudentID) AS TotalStudents
FROM Course C
JOIN Students S
ON C.CourseID = S.CourseID
GROUP BY C.CourseName
HAVING COUNT(S.StudentID) >= 5;

