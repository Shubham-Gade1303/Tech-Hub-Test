1. Write a SQL query to find the students who scored more than 80 marks in 
any course. Display student name, course name and marks. 

---> SELECT s.student_name , c.course_name, e.marks 
from student s 
Join enrollment e on    
s.student_id = e.student_id 
Join course c on c.course_id = e.course_id 
where e.marks > 80;


2. Write a SQL query to count how many students enrolled in each course. 
Display course name and total students.

--->  
select c.course_name , count(e.student_id)
     as total_count
     from course c
     left join enrollment e on
     c.course_id = e.course_id
     group by c.course_name;


3. Write a SQL query to find students who enrolled in multiple courses using 
GROUP BY and HAVING clause. 

--->
Select s.student_name
from student s 
join enrollment e on
s.student_id = e.student_id
group by s.student_name having count(e.course_id)>1;


4. Write a SQL query using subquery to find students who scored above the 
average marks of all students.

---> 
select s.student_name 
from student s 
join enrollment e 
on s.student_id = e.student_id 
where e.marks > (select avg(marks) from enrollment);



5. Write a SQL query to display student names along with their enrolled course 
names and obtained marks by joining Student, Enrollment and Course tables.

--->
 select s.student_name , c.course_name, e.marks
  from student s
  join enrollment e on s.student_id= e.student_id
  join course c on c.course_id = e.course_id;


  6. Write a SQL query to display student name, city and course name for 
students whose city is Pune using JOIN.


--->
select s.student_name , s.city, c.course_name
from student s
join  enrollment e on s.student_id = e.student_id 
join course c on c.course_id = e.course_id 
where s.city ='pune';



7. Write a SQL query to display the student name and marks of the student who 
scored the highest marks using JOIN and subquery. 
--->
select s.student_name , e.marks 
from student s 
join enrollment e on s.student_id = e.student_id 
where e.marks = (select max(marks) from enrollment);



8. Write a SQL query to find students who enrolled in more than one course 
using GROUP BY and HAVING.
---> 
select s.student_name 
from student s
join enrollment e on s.student_id = e.student_id
group by s.student_name
having count(e.course_id) >1;



9. Write a SQL query to display course names and average marks obtained by 
students in each course.
---->
select c.course_name , avg(e.marks) as avg_marks 
from course c
join enrollment e on c.course_id = e.course_id 
group by c.course_name;

